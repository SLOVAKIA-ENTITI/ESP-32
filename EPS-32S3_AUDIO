// Piny pre ESP32-S3-AUDIN
#define I2S_DOUT      19 
#define I2S_BCLK      21 
#define I2S_LRC       20 
#define I2S_MIC_SD    10 
#define I2C_SDA       1
#define I2C_SCL       2
#define ES8388_ADDR   0x10
#define BOOT_BUTTON_PIN 0

Audio audio;
WiFiClientSecure client;

void writeReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(ES8388_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

void initES8388() {
  Serial.println("--- PRÁCA S PINMI 15 a 16 ---");
  
  pinMode(48, OUTPUT); 
  digitalWrite(48, HIGH); // Zapne napájanie audio vetvy
  delay(200);

  Wire.begin(15, 16); // SDA: 15, SCL: 16
  delay(100);

  Wire.beginTransmission(0x10);
  if (Wire.endTransmission() == 0) {
    Serial.println(">>> NAŠIEL SA NA 15/16! <<<");
    // ... tu pôjdu tie writeReg príkazy ...
  } else {
    Serial.println("Ani 15/16 nejdú. Skús napísať 'Ahoj' do Serialu, či Gemini žije.");
  }
}
void setup() {
  Serial.begin(115200);
  delay(2000); 
  Serial.println("--- START ---");

  initES8388();

  // TU JE ZMENA: Najprv inicializujeme audio výstup
  // Audio.h si zaberie I2S ovládač legálnym spôsobom
  audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
  audio.setVolume(15);

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi OK!");
  
  pinMode(BOOT_BUTTON_PIN, INPUT_PULLUP);
  Serial.println("Pripraveny. Skus poslat text cez Serial.");
}

// Funkcia pre Gemini
String askGemini(String otazka) {
  HTTPClient http;
  client.setInsecure();
  String url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" + String(gemini_key);
  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");
  String json = "{\"contents\": [{\"parts\":[{\"text\":\"" + otazka + " (kratko slovensky)\"}]}]}";
  int code = http.POST(json);
  if (code == 200) {
    String res = http.getString();
    int start = res.indexOf("\"text\": \"") + 9;
    int end = res.indexOf("\"", start);
    String out = res.substring(start, end);
    out.replace("\\n", " ");
    return out;
  }
  return "Chyba.";
}

void loop() {
  audio.loop();

  // Test cez Serial Monitor (toto nespôsobí konflikt)
