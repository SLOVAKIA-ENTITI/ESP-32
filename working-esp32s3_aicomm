// ============================================================
//  SETUP
// ============================================================
void setup() {
  esp_task_wdt_deinit();
  Serial.begin(115200);
  delay(500);
  Serial.println("\n========================================");
  Serial.println("  ESP32-S3 AI Voice Assistant");
  Serial.println("========================================");

  pinMode(RECORD_BTN, INPUT_PULLUP);
  pinMode(PA_EN_PIN, OUTPUT);
  digitalWrite(PA_EN_PIN, HIGH);
  Serial.println("[PA] Amplifier enabled.");

  if (psramFound()) {
    recordBuf = (uint8_t*)ps_malloc(MAX_BUF_BYTES);
    if (recordBuf) Serial.printf("[RAM] PSRAM buffer: %u bytes (%d s max)\n", MAX_BUF_BYTES, MAX_RECORD_SEC);
    else           Serial.println("[ERROR] PSRAM malloc failed!");
  } else {
    Serial.println("[WARN] No PSRAM — using heap.");
    recordBuf = (uint8_t*)malloc(MAX_BUF_BYTES);
  }

  initES8388();

  audio.setPinout(I2S_BCLK_PIN, I2S_LRCK_PIN, I2S_DIN_PIN);
  audio.setVolume(18);

  Serial.print("[WiFi] Connecting");
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.println("\n[WiFi] Connected: " + WiFi.localIP().toString());
  Serial.println("\n[READY] Drz tlacidlo GPIO4 a hovor!");
}

// ============================================================
//  LOOP
// ============================================================
void loop() {
  audio.loop();

  switch (currentState) {

    case STATE_IDLE:
      if (digitalRead(RECORD_BTN) == LOW) {
        delay(50);
        if (digitalRead(RECORD_BTN) == LOW) {
          Serial.println("\n[STATE] RECORDING");
          currentState = STATE_RECORDING;
          recordAudio();
          currentState = STATE_PROCESSING;
          Serial.println("[STATE] PROCESSING");
        }
      }
      break;

    case STATE_PROCESSING: {
      String transcript = transcribeAudio();
      if (transcript.isEmpty()) { Serial.println("[PROC] No transcript."); currentState = STATE_IDLE; break; }
      String answer = askGemini(transcript);
      if (answer.isEmpty()) answer = "Prepacte, nerozumel som vam.";
      currentState = STATE_SPEAKING;
      Serial.println("[STATE] SPEAKING");
      speakText(answer);
      break;
    }

    case STATE_SPEAKING:
      break;

    default:
      break;
  }
}
