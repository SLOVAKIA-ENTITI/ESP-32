    String otazka = Serial.readStringUntil('\n');
    Serial.println("Ty: " + otazka);
    String odpoved = askGemini(otazka);
    Serial.println("AI: " + odpoved);
    audio.connecttospeech(odpoved.c_str(), "sk"); 
  }
}
