// Piny pre ESP32-S3-AUDIN (Podľa schémy RE1.0)
#define I2S_DOUT      19 
#define I2S_BCLK      21 
#define I2S_LRC       20 
#define I2C_SDA       1
#define I2C_SCL       2
#define ES8388_ADDR   0x10
#define BOOT_BUTTON_PIN 0

Audio audio;
WiFiClientSecure client;

void writeReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(ES8388_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

void initES8388() {
  Serial.println("--- NATVRDO ŠTARTUJEM AUDIO ---");
  pinMode(48, OUTPUT); 
  digitalWrite(48, HIGH); // Zapnutie napájania audio vetvy
  delay(500); 

  Wire.begin(I2C_SDA, I2C_SCL);
  
  // Rozšírená sekvencia pre ES8388
  writeReg(0x01, 0x00); // Reset off
  writeReg(0x00, 0x06); // ADC a DAC power up
  writeReg(0x04, 0x00); // I2S Master mode
  writeReg(0x05, 0x00); 
  writeReg(0x08, 0x00); // 16bit, I2S formát
  writeReg(0x2E, 0x1C); // LOUT1 enable
  writeReg(0x2F, 0x1C); // ROUT1 enable
  writeReg(0x30, 0x1C); // LOUT2 enable
  writeReg(0x31, 0x1C); // ROUT2 enable
  writeReg(0x26, 0x00); // Unmute
  writeReg(0x27, 0xCF); // Hlasitosť
  Serial.println("Audio registre odoslané.");
}

// Vylepšená funkcia pre Gemini s výpisom chýb
String askGemini(String otazka) {
  if (otazka.length() < 1) return "";
  
  HTTPClient http;
  client.setInsecure();
  String url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" + String(gemini_key);
  
  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");
  
  // Ošetrenie špeciálnych znakov v JSON
  String json = "{\"contents\": [{\"parts\":[{\"text\":\"" + otazka + " (odpovedaj kratko slovensky)\"}]}]}";
  
  Serial.println("Odosielam dopyt na Gemini...");
  int code = http.POST(json);
  
  if (code == 200) {
    String res = http.getString();
    int start = res.indexOf("\"text\": \"");
    if (start != -1) {
      start += 9;
      int end = res.indexOf("\"", start);
      String out = res.substring(start, end);
      out.replace("\\n", " ");
      out.replace("\\\"", "\"");
      return out;
    }
    return "Chyba spracovania odpovede.";
  } else {
    Serial.printf("Chyba Google API: %d\n", code);
    return "Chyba " + String(code);
  }
}

void setup() {
  Serial.begin(115200);
  delay(2000); 
  Serial.println("\n--- SYSTEM START ---");

  // 1. Audio hardvér
  initES8388();
  audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
  audio.setVolume(18); // Trochu vyššia hlasitosť

  // 2. WiFi
  WiFi.begin(ssid, password);
  Serial.print("Pripájam WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi OK!");
  
  // 3. Čas (nutný pre HTTPS)
  configTime(3600, 3600, "pool.ntp.org");
  Serial.print("Synchronizujem čas");
  while (time(nullptr) < 1000) { 
    delay(500); 
    Serial.print("."); 
  }
  Serial.println("\nČas je nastavený!");

  pinMode(BOOT_BUTTON_PIN, INPUT_PULLUP);
  Serial.println(">>> PRIPRAVENÝ. Napíš niečo do Serial Monitora. <<<");
}

void loop() {
